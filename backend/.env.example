# Copy to backend/.env (git-ignored) and fill in. Leave GOOGLE_* empty to run
# without sign-in as a single local user.

# Google Cloud Console → Google Auth Platform → Clients → your Web client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must exactly match an "Authorized redirect URI" of that client.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Where to send the browser after sign-in. Empty = same origin as the API.
# For the Vite dev server use http://localhost:5173
FRONTEND_URL=
